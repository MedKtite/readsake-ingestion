# The SAME database the Spring Boot backend uses.
DATABASE_URL=postgresql://marginalia:marginalia@localhost:5432/marginalia

# Nightly Gutenberg Home snapshot
GUTENBERG_TOP_URL=https://www.gutenberg.org/browse/scores/top
GUTENDEX_URL=https://gutendex.com/books/

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu            # cpu | cuda

# Storage — local (default)
STORAGE_BACKEND=local         # local | s3
STORAGE_DIR=./cleaned
#STORAGE_PUBLIC_BASE=http://localhost:8080/audio

# Storage — s3 / MinIO (used when STORAGE_BACKEND=s3; AWS creds come from
# the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars)
#S3_BUCKET=marginalia-audio
#S3_ENDPOINT_URL=http://localhost:9000
#S3_PUBLIC_BASE=https://cdn.example.com/audio
